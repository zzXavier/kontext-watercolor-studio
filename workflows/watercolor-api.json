      "title": "Watercolor instruction"
    }
  },
  "7": {
    "class_type": "ReferenceLatent",
    "inputs": {
      "conditioning": [
        "6",
        0
      ],
      "latent": [
        "4",
        0
      ]
    },
    "_meta": {
      "title": "Condition on source content"
    }
  },
  "8": {
    "class_type": "FluxGuidance",
    "inputs": {
      "conditioning": [
        "7",
        0
      ],
      "guidance": 2.5
    },
    "_meta": {
      "title": "Edit guidance"
    }
  },
  "9": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "6",
        0
      ]
    },
    "_meta": {
      "title": "Neutral negative condition"
    }
  },
  "10": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {
      "unet_name": "flux1-kontext-dev-Q4_K_S.gguf"
